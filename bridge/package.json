    "nanoid": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
