BRIDGE_PORT=8787
BRIDGE_TOKEN=change-me
BRIDGE_PERMISSION_MODE=manual_review

# dry-run | cli | app-server
CODEX_EXECUTION=dry-run
CODEX_BIN=codex
CODEX_ARGS=exec --json
CODEX_JOB_TIMEOUT_MS=1200000

# app-server settings
CODEX_APP_SERVER_MODEL=
CODEX_APP_SERVER_APPROVAL_POLICY=unlessTrusted
CODEX_APP_SERVER_SANDBOX=workspaceWrite
CODEX_APP_SERVER_NETWORK=false
# prompt | decline | accept
CODEX_APP_SERVER_APPROVAL_RESPONSE=prompt

# Safety limits
REQUIRE_APPROVAL_FOR_ALL_RUNS=true
MAX_FILE_BYTES=200000
MAX_SNAPSHOT_FILES=40
